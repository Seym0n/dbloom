# Copy to .env. See SPEC/12-settings.md for the settings classification.
PORT=3000

# Direct mode needs a named target list or an explicit acknowledgement (SEC-TGT-018).
# Names the servers users may connect to, host:port, comma separated:
#DBLOOM_DIRECT_TARGETS=db.example.com:3306
# or accept free-form targets (only behind other protections):
#DBLOOM_DIRECT_FREE_FORM_ACK=true

# Blocked address classes stay blocked unless allowed here (SEC-TGT-030).
DBLOOM_ALLOW_LOOPBACK=false
DBLOOM_ALLOW_PRIVATE=false

# TLS to targets: verify (default), skip-verify, off
DBLOOM_TARGET_TLS=verify

# Behind a reverse proxy such as Coolify's: use X-Forwarded-For for the client address.
DBLOOM_TRUST_PROXY=false

# Sessions: idle minutes and absolute hours (defaults 30 and 12).
DBLOOM_SESSION_IDLE_MINUTES=30
DBLOOM_SESSION_ABSOLUTE_HOURS=12

# Store directory (the compose file mounts a volume at /data).
DBLOOM_DATA_DIR=/data

# Import and export (module io). Staged uploads and export files; default <data dir>/tmp, mode 0700.
#DBLOOM_TEMP_DIR=/data/tmp
# Total size of staged and spooled files in MiB (default 10240).
#DBLOOM_TEMP_QUOTA_MIB=10240
# Upper bound of the upload size in MiB, 1 to 2048 (the default upload size is 64 MiB within this bound).
#DBLOOM_IMPORT_MAX_MIB=2048
# Enables importing files from a server folder (off when unset). Absolute path; symbolic links are refused.
#DBLOOM_IMPORT_DIR=/data/import
