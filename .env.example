#DBLOOM_ARGON2_PARALLELISM=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_VAULT_ARGON2_MEMORY_MIB=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_VAULT_ARGON2_PASSES=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_VAULT_ARGON2_PARALLELISM=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_TEMP_PASSWORD_HOURS=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_ADMIN_SESSION_IDLE_MINUTES=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_ADMIN_SESSION_ABSOLUTE_HOURS=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_SESSIONS_PER_USER=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_SESSIONS_PER_ADMIN=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_SESSIONS_AT_LIMIT=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_LOGIN_FAILURES=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_LOGIN_BACKOFF_CAP_MINUTES=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_LOGIN_WINDOW_MINUTES=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_LOGIN_ADDRESS_FAILURES=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_INVITE_HOURS=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_RECOVERY_LINK_HOURS=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_VAULT_PASSPHRASE_MIN=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_VAULT_AUTOLOCK_MINUTES=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_PERSONAL_PROFILES=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_ALLOW_EMPTY_TARGET_PASSWORD=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_DENY_ROOT_TARGET=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_LOGIN_RECALL=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_STEPUP_MINUTES=
# Auth setting override (file 26); validated by the auth module.
#DBLOOM_AUTOREVERT_MINUTES=

# --- SQL ---
# Turns the SQL module off.
#DBLOOM_SQL_DISABLED=false
# `off` is the parser kill switch.
#DBLOOM_SQL_PARSER=
# Result row cap.
#DBLOOM_SQL_ROW_CAP=
# Response size cap in MB.
#DBLOOM_SQL_RESPONSE_MB=
# Cell size cap in KB.
#DBLOOM_SQL_CELL_KB=
# Statements per run.
#DBLOOM_SQL_MAX_STATEMENTS=
# Concurrent runs per session.
#DBLOOM_SQL_MAX_CONCURRENT_RUNS=

# --- Rows ---
# Largest page size.
#DBLOOM_ROWS_MAX_PAGE_SIZE=
# Exact count threshold.
#DBLOOM_ROWS_EXACT_COUNT_THRESHOLD=
# Count cap of views.
#DBLOOM_ROWS_VIEW_COUNT_CAP=
# Cell size cap in bytes.
#DBLOOM_ROWS_CELL_BYTES=
# Cell upload cap in bytes.
#DBLOOM_ROWS_UPLOAD_BYTES=
# Bulk operation size.
#DBLOOM_ROWS_BULK_SIZE=
# Rows per insert form.
#DBLOOM_ROWS_INSERT_ROWS=
